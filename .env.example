VITE_CLOUDBASE_ENV_ID=your-cloudbase-env-id
VITE_CLOUDBASE_PUBLISHABLE_KEY=your-publishable-key

# AI 总结：deepseek（推荐，本地走 Vite 代理，线上走 CloudBase 云函数）
VITE_AI_BACKEND=deepseek
VITE_DEEPSEEK_MODEL=deepseek-chat
VITE_DEEPSEEK_FUNCTION=deepseek-chat

# DeepSeek API Key（仅本地/云函数环境变量，不要加 VITE_ 前缀，避免打包进前端）
DEEPSEEK_API_KEY=your-deepseek-api-key
