{
  "version": "2.0",
  "envId": "your-env-id",
  "app": {
    "serviceName": "dailylogs",
    "framework": "vite",
    "installCommand": "npm install",
    "buildCommand": "npm run build:ci",
    "outputDir": "dist",
    "deployPath": "/dailylogs",
    "envVariables": {
      "VITE_CLOUDBASE_ENV_ID": "your-env-id",
      "VITE_CLOUDBASE_PUBLISHABLE_KEY": "your-publishable-key"
    }
  }
}
