{
  "name": "daily-log",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:ci": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "deploy": "npm run build:ci && npx tcb hosting deploy .\\dist /dailylogs",
    "deploy:function": "node scripts/deploy-function.mjs",
    "deploy:all": "npm run deploy:function && npm run deploy"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.8.0",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@cloudbase/cli": "^3.7.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  }
}
